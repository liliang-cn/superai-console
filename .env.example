# Where SuperAI's serve mode is listening.
SUPERAI_URL=http://192.168.123.65:43118

# Optional, and best left empty.
#
# Set, the dev proxy signs every request in and the console never shows its
# sign-in screen — so dev stops resembling the deployed build, which
# authenticates with the password and a session cookie. Leave it blank and log
# in the same way locally.
#
# Never do this in front of a public hostname: it is the agent, with shell
# tools, behind no door.
SUPERAI_TOKEN=
